# ============================================================
# NamMaLaew — Environment Variables
# ============================================================
# Values set in the dashboard UI (Settings page) are stored in
# SQLite and override the values in this file.
# ============================================================

# --- Camera streams (Docker compose form uses host.docker.internal) ---
# Comma-separated label=url pairs served by go2rtc on the Mac host.
# For Docker: use host.docker.internal instead of 127.0.0.1
CAM_STREAMS=street=rtsp://host.docker.internal:8554/ec6_2,carport=rtsp://host.docker.internal:8554/ec6

# Legacy single-camera RTSP URL (used only when CAM_STREAMS is empty).
CAM_RTSP_URL=

# --- Claude Code CLI authentication ---
# Run `claude setup-token` on your Mac and paste the token here.
# No Anthropic API key is needed — a Claude subscription is sufficient.
CLAUDE_CODE_OAUTH_TOKEN=

# Claude model (default: sonnet)
# Accepts CLI aliases (sonnet / opus / haiku) or a full model id
# e.g. claude-sonnet-4-5, claude-opus-5, claude-haiku-4-5
CLAUDE_MODEL=sonnet

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: hour (0-23) for daily "alive" heartbeat; blank = off ---
HEARTBEAT_HOUR=

# --- Reference description for level_index scale (blank = built-in default) ---
# The built-in default describes the IMILAB EC6 Dual street+carport layout.
# level_index 0=dry, 25=water on street only, 50=water at gate, 75=water in driveway, 100=carport floor
REFERENCE_DESCRIPTION=

# --- Snapshot retention (hours, default 168 = 7 days) ---
SNAPSHOT_RETENTION_HOURS=168

# --- Rainfall data (leave blank to disable) ---
LATITUDE=
LONGITUDE=

# --- Dashboard ---
# Password for the web dashboard
DASHBOARD_PASSWORD=

# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
DASHBOARD_SECRET=

# --- Siren (MQTT / zigbee2mqtt) ---
# Hostname or IP of the Mosquitto broker on your LAN.
# Credentials belong only in .env — never commit this file with real values.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
SIREN_TOPIC=zigbee2mqtt/Siren/set
